<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>KCAccessSetup</AssemblyName>
    <RootNamespace>KCAccess.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>KCAccess Setup</Product>
    <Description>Installs and updates the KCAccess screen reader mod for Kingdoms and Castles</Description>
    <!-- Loc.cs is shared with the mod; INSTALLER makes its types internal here. -->
    <DefineConstants>$(DefineConstants);INSTALLER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\KCAccess.Core\Loc.cs" Link="Loc.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <!-- The release zip (BepInEx + mod) is embedded so the installer also works offline. -->
  <ItemGroup Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
